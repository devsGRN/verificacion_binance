<odoo>
    <record id="view_binance_receipt_wizard" model="ir.ui.view">
        <field name="name">binance.receipt.wizard.form</field>
        <field name="model">binance.receipt.wizard</field>
        <field name="arch" type="xml">
            <form string="Leer comprobante">
                <group>
                    <field name="company_id" string="Compañía"/>
                    <field name="account_id" string="Cuenta receptora" domain="[('company_id', 'in', [False, company_id])]"/>
                    <field name="screenshot_timezone"/>
                    <field name="filename" invisible="1"/>
                    <field name="image" filename="filename" options="{'accepted_file_extensions': '.jpg,.jpeg,.png'}"/>
                </group>
                <footer>
                    <button name="action_read_receipt" type="object" string="Leer captura" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_binance_receipt_wizard" model="ir.actions.act_window">
        <field name="name">Leer comprobante</field>
        <field name="res_model">binance.receipt.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <menuitem id="menu_binance_receipt_wizard" name="Leer comprobante"
              parent="menu_binance_root" action="action_binance_receipt_wizard" groups="base.group_system"/>
</odoo>
